# Template for scratch/deploy_to_vps.js — copy this to a repo-root ".env"
# file (already gitignored via ".env*" in .gitignore) and fill in the real
# values. Never commit the real .env file.
#
# See audit-2026/findings/14-infrastructure-devops.md — the actual VPS root
# password used to be hardcoded directly in scratch/deploy_to_vps.js and was
# already committed to git history before this was fixed. That old password
# still needs to be rotated on the VPS itself; this file only stops new
# plaintext copies from being committed going forward.

VPS_HOST=167.86.76.229
VPS_USER=root
VPS_SSH_PASSWORD=
